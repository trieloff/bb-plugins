{
  "name": "@smsunarto/bb-plugin-thread-limit",
  "version": "0.1.0",
  "private": true,
  "description": "bb's concurrency limit, copied, with one difference: pinned threads are never held.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "assets/",
    "components/",
    "lib/",
    "skills/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "\"${BB_CLI:?Run bun run dev from the repository root}\" plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=30000",
    "check": "node --import tsx ../../packages/bb-kit-dev/src/bin.ts check",
    "clean": "rm -rf dist"
  },
  "bb": {
    "name": "Thread limit",
    "description": "Limit how many threads run at once, per machine and overall. A copy of bb's concurrency limit that never holds a pinned thread.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
    "host": "./src/host/host.ts",
    "skills": [
      "skills"
    ]
  },
  "engines": {
    "bb": ">=0.44.0 <1.0.0",
    "bbPluginSdk": ">=0.5.26"
  },
  "dependencies": {
    "@bb-kit/core": "0.2.0",
    "@tanstack/react-query": "^5.101.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.4.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  }
}
